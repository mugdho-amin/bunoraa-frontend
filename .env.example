# ── Bunoraa frontend environment template ──
# Copy this file to .env.local and fill in your values for local development.
# In production, these must be set via your hosting platform's environment variables.
# NEXT_PUBLIC_* variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER commit actual secrets to version control — use .env.local locally
# and your platform's env/secrets manager in production.

# Local development — override to point at your local backend:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_INTERNAL_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_USE_PROXY=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

# Site identity (overrides default "Bunoraa" used in SEO metadata; sourced from admin panel > Constance > SITE_NAME)
NEXT_PUBLIC_SITE_NAME=

# Optional services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_BEACON_ENABLED=false

# Logging Level (debug | info | warn | error)
NEXT_PUBLIC_LOG_LEVEL=info

# Telemetry
NEXT_TELEMETRY_DISABLED=1
